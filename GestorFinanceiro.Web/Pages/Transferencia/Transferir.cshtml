@page
@model GestorFinanceiro.Web.Pages.Transferencia.TransferirModel

@{
    ViewData["Title"] = "Transferir Saldo";
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Transferir saldo</h1>
            <p class="subtitle">Cria despesa na origem e receita no destino</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary btn-app-sm">← Dashboard</a>
    </div>

    <div class="sessions-card form-card">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
        }

        @if (Model.Resumos.Count >= 2)
        {
            <form method="post" class="form-app">
                <div class="field-group">
                    <label asp-for="SessaoOrigemId" class="form-label">Sessão de origem</label>
                    <select asp-for="SessaoOrigemId" asp-items="Model.SessoesOrigem"
                            class="form-control" id="SessaoOrigemId"></select>
                    <small class="form-hint" id="saldo-hint" style="display:none">
                        Saldo disponível: <strong id="saldo-valor"></strong>
                    </small>
                </div>
                <div class="field-group">
                    <label asp-for="SessaoDestinoId" class="form-label">Sessão de destino</label>
                    <select asp-for="SessaoDestinoId" asp-items="Model.SessoesDestino" class="form-control"></select>
                </div>
                <div class="field-group">
                    <label asp-for="Valor" class="form-label">Valor (€)</label>
                    <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <div class="field-group">
                    <label asp-for="Descricao" class="form-label">Descrição (opcional)</label>
                    <input asp-for="Descricao" class="form-control" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-app btn-app-success">Transferir</button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary">Cancelar</a>
                </div>
            </form>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var saldos = {
            @foreach (var r in Model.Resumos)
            {
                    @:@r.SessaoId: @r.Saldo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
            }
        };

        function atualizarSaldo() {
            var id = parseInt(document.getElementById("SessaoOrigemId").value);
            var hint = document.getElementById("saldo-hint");
            var span = document.getElementById("saldo-valor");

            if (saldos[id] !== undefined) {
                span.textContent = saldos[id].toFixed(2).replace(".", ",") + " \u20AC";
                hint.style.display = "block";
            } else {
                hint.style.display = "none";
            }
        }

        document.getElementById("SessaoOrigemId").addEventListener("change", atualizarSaldo);
        atualizarSaldo();
    </script>
}
