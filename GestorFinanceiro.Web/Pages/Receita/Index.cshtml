@page "{sessaoId:int}"
@model GestorFinanceiro.Web.Pages.Receita.IndexModel

@{
    ViewData["Title"] = "Receitas";
    var total = Model.Receitas.Sum(r => r.Valor);
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Receitas</h1>
            <p class="subtitle">@Model.SessaoNome</p>
        </div>
        <a asp-page="Create" asp-route-sessaoId="@Model.SessaoId" class="btn-app btn-app-success">➕ Nova Receita</a>
    </div>

    <div class="mt-3 d-flex gap-3 flex-wrap">
        <a asp-page="/SessaoFinanceira/Detalhe" asp-route-id="@Model.SessaoId" class="back-link">← Voltar à sessão</a>
        <a asp-page="/SessaoFinanceira/Index" class="back-link">Todas as sessões</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }
    else if (Model.Receitas.Any())
    {
        <div class="summary-cards summary-cards--compact mb-4">
            <div class="summary-card summary-card--receitas">
                <span class="summary-label">Total nesta sessão</span>
                <div class="value value--hero">@total.ToString("N2") €</div>
            </div>
            <div class="summary-card summary-card--sessions">
                <span class="summary-label">Registos</span>
                <div class="value value--hero">@Model.Receitas.Count</div>
            </div>
        </div>
    }

    <div class="sessions-card section-block">
        @if (!Model.Receitas.Any() && string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="empty-state">
                <p>Sem dados disponíveis. Ainda não existem receitas nesta sessão.</p>
                <a asp-page="Create" asp-route-sessaoId="@Model.SessaoId" class="btn-app btn-app-success">Registar primeira receita</a>
            </div>
        }
        else if (Model.Receitas.Any())
        {
            <div class="historico-list">
                @foreach (var receita in Model.Receitas)
                {
                    <div class="historico-item">
                        <span class="historico-icone historico-icone--entrada">↑</span>
                        <div class="historico-info">
                            <span class="historico-descricao">@receita.Descricao</span>
                            <span class="historico-tipo">@receita.Data.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="historico-right">
                            <span class="historico-valor" style="color:var(--success)">@receita.Valor.ToString("N2") €</span>
                            <div style="display:flex; gap:0.4rem; margin-top:0.25rem; justify-content:flex-end">
                                <a asp-page="Edit" asp-route-sessaoId="@Model.SessaoId" asp-route-id="@receita.Id"
                                   class="btn-app btn-app-sm btn-app-outline">Editar</a>
                                <a asp-page="Delete" asp-route-sessaoId="@Model.SessaoId" asp-route-id="@receita.Id"
                                   class="btn-app btn-app-sm btn-app-outline-danger">Eliminar</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
