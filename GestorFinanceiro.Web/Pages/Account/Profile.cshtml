@page "/Account/Profile"
@model GestorFinanceiro.Web.Pages.Account.ProfileModel

@{
    ViewData["Title"] = "Perfil";
    var initials = string.IsNullOrEmpty(Model.Nome) ? "?" : (Model.Nome.Length >= 2 ? Model.Nome[..2] : Model.Nome).ToUpper();
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Perfil</h1>
            <p class="subtitle">Os teus dados de conta</p>
        </div>
        <div class="dashboard-header-actions">
            <a asp-page="/Account/Settings" class="btn-app btn-app-outline btn-app-sm">⚙️ Definições</a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary btn-app-sm">← Dashboard</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }

    <div class="detail-grid" style="align-items:start">

        @* Coluna esquerda — avatar *@
        <div class="sessions-card" style="text-align:center; padding: 2rem 1.5rem">
            <div style="margin-bottom:1.25rem">
                @if (!string.IsNullOrEmpty(Model.ImagemPerfil))
                {
                    <img src="@Model.ImagemPerfil" alt="Avatar"
                         style="width:7rem; height:7rem; border-radius:50%; object-fit:cover; border:3px solid var(--border); margin:0 auto 1rem; display:block" />
                }
                else
                {
                    <div style="width:7rem; height:7rem; border-radius:50%; background:var(--auth-brand-bg); color:#fff; font-size:2rem; font-weight:800; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem">
                        @initials
                    </div>
                }
                <h2 style="font-size:1.25rem; font-weight:800; margin:0">@Model.Nome</h2>
                <p style="color:var(--text-muted); margin:0.25rem 0 0; font-size:0.9rem">@@@Model.Username</p>
                <span style="display:inline-block; margin-top:0.5rem; background:var(--surface-muted); border:1px solid var(--border); border-radius:999px; padding:0.2rem 0.75rem; font-size:0.75rem; font-weight:700; color:var(--text-secondary)">@Model.Role</span>
            </div>

            <hr style="border:none; border-top:1px solid var(--border); margin:1.25rem 0" />

            <form method="post" enctype="multipart/form-data" asp-page-handler="Imagem" class="form-app" style="text-align:left">
                <label class="form-label">Alterar foto de perfil</label>
                <input type="file" asp-for="ImagemUpload" class="form-control" accept="image/jpeg,image/png,image/webp"
                       style="margin-bottom:0.65rem" />
                <button type="submit" class="btn-app btn-app-outline btn-app-sm" style="width:100%">Guardar foto</button>

            </form>
        </div>

        @* Coluna direita — dados e edição *@
        <div class="sessions-card" id="profileCard" data-edit-mode="@(Model.EditMode ? "true" : "false")">

            @* Vista normal *@
            <div id="profileView" class="profile-mode @(Model.EditMode ? "profile-mode--hidden" : "")">
                <h2 class="section-title section-title--sm">Informações</h2>
                <div class="historico-list" style="margin-bottom:1.5rem">
                    <div class="historico-item">
                        <div class="historico-info">
                            <span class="historico-tipo">Nome</span>
                            <span class="historico-descricao">@Model.Nome</span>
                        </div>
                    </div>
                    <div class="historico-item">
                        <div class="historico-info">
                            <span class="historico-tipo">Username</span>
                            <span class="historico-descricao">@@@Model.Username</span>
                        </div>
                    </div>
                    <div class="historico-item">
                        <div class="historico-info">
                            <span class="historico-tipo">Email</span>
                            <span class="historico-descricao">@Model.Email</span>
                        </div>
                    </div>
                    <div class="historico-item">
                        <div class="historico-info">
                            <span class="historico-tipo">Função</span>
                            <span class="historico-descricao">@Model.Role</span>
                        </div>
                    </div>
                </div>
                


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
