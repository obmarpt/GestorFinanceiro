@page "/Account/Settings"
@model GestorFinanceiro.Web.Pages.Account.SettingsModel

@{
    ViewData["Title"] = "Definições";
    var initials = string.IsNullOrEmpty(Model.Nome) ? "?" : (Model.Nome.Length >= 2 ? Model.Nome[..2] : Model.Nome).ToUpper();
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Definições</h1>
            <p class="subtitle">Atualiza os teus dados de conta</p>
        </div>
        <a asp-page="/Account/Profile" class="btn-app btn-app-secondary btn-app-sm">← Perfil</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }

    <div class="detail-grid" style="align-items:start">

        @* Coluna esquerda — avatar *@
        <div class="sessions-card" style="text-align:center; padding:2rem 1.5rem">
            @if (!string.IsNullOrEmpty(Model.ImagemPerfil))
            {
                <img src="@Model.ImagemPerfil" alt="Avatar"
                     style="width:7rem; height:7rem; border-radius:50%; object-fit:cover; border:3px solid var(--border); margin:0 auto 1rem; display:block" />
            }
            else
            {
                <div style="width:7rem; height:7rem; border-radius:50%; background:var(--auth-brand-bg); color:#fff; font-size:2rem; font-weight:800; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem">
                    @initials
                </div>
            }
            <h2 style="font-size:1.25rem; font-weight:800; margin:0">@Model.Nome</h2>
            <p style="color:var(--text-muted); margin:0.25rem 0 0; font-size:0.9rem">@Model.Email</p>
        </div>

        @* Coluna direita — formulário *@
        <div class="sessions-card">
            <form method="post" class="form-app">

                <h2 class="section-title section-title--sm">Perfil</h2>

                <div class="field-group">
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <hr style="border:none; border-top:1px solid var(--border); margin:1.5rem 0" />

                <h2 class="section-title section-title--sm">Segurança</h2>
                <p style="font-size:0.875rem; color:var(--text-muted); margin:-0.75rem 0 1rem">Deixa em branco para manter a password atual.</p>

                <div class="field-group">
                    <label asp-for="NovaPassword" class="form-label">Nova password</label>
                    <input asp-for="NovaPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="field-group">
                    <label asp-for="ConfirmarPassword" class="form-label">Confirmar password</label>
                    <input asp-for="ConfirmarPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-app btn-app-success">Guardar alterações</button>
                    <a asp-page="/Account/Profile" class="btn-app btn-app-secondary">Cancelar</a>
                </div>

            </form>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
