@page "{id:int}"
@model GestorFinanceiro.Web.Pages.Meta.EditModel

@{
    ViewData["Title"] = "Editar Conta Poupança";
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Editar Conta Poupança</h1>
            <p class="subtitle">Atualiza o teu objetivo de poupança</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary btn-app-sm">← Dashboard</a>
    </div>

    <div class="sessions-card form-card">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
        }

        <form method="post" class="form-app">
            <div class="field-group">
                <label asp-for="Nome" class="form-label">Nome da Conta Poupança</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="Descricao" class="form-label">Descrição (opcional)</label>
                <input asp-for="Descricao" class="form-control" />
            </div>
            <div class="field-group">
                <label asp-for="ValorAlvo" class="form-label">Valor alvo (€)</label>
                <input asp-for="ValorAlvo" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="ValorAlvo" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="ValorAtual" class="form-label">Valor atual (€)</label>
                <input asp-for="ValorAtual" class="form-control" type="number" step="0.01" min="0" />
                <small class="form-hint">Atualiza quanto já tens poupado para esta conta poupança.</small>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-app btn-app-success">Guardar</button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary">Cancelar</a>
            </div>
        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
