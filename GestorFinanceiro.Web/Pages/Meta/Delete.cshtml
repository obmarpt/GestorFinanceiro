@page "{id:int}"
@model GestorFinanceiro.Web.Pages.Meta.DeleteModel

@{
    ViewData["Title"] = "Apagar Meta";
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Apagar meta</h1>
            <p class="subtitle">Esta ação é irreversível</p>
        </div>
        <a asp-page="/Dashboard/Index" class="btn-app btn-app-secondary btn-app-sm">← Dashboard</a>
    </div>

    <div class="sessions-card form-card">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
        }

        @if (Model.NomeMeta != null)
        {
            <p>Tens a certeza que queres apagar a meta <strong>@Model.NomeMeta</strong>?</p>

            <form method="post" class="form-app">
                <div class="form-actions">
                    <button type="submit" class="btn-app btn-app-danger">Apagar</button>
                    <a asp-page="/Dashboard/Index" class="btn-app btn-app-secondary">Cancelar</a>
                </div>
            </form>
        }

    </div>

</div>
