@page "{id:int}"
@model GestorFinanceiro.Web.Pages.Meta.DeleteModel
@using System.Globalization

@{
    ViewData["Title"] = "Apagar Conta Poupança";
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Apagar Conta Poupança</h1>
            <p class="subtitle">Confirma que pretendes eliminar esta conta poupança</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary btn-app-sm">← Dashboard</a>
    </div>

    <div class="sessions-card form-card">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
        }

        @if (Model.NomeMeta != null)
        {
            <div class="alert alert-app alert-app-danger" style="margin-bottom:1.5rem">
                Estás prestes a apagar a conta poupança <strong>@Model.NomeMeta</strong>.
                Esta ação é irreversível.
            </div>

            @if (Model.ValorAtual > 0)
            {
                <div class="sessions-card" style="margin-bottom:1.5rem; padding: 1.25rem 1.5rem; background: var(--kpi-receitas-bg); border-color: var(--kpi-receitas-border)">
                    <p style="margin:0; font-weight:600; color: var(--success-dark)">
                        Esta conta poupança tem <strong>@Model.ValorAtual.ToString("N2") €</strong> acumulados.
                        Para confirmar o apagar, tens de inserir esse valor abaixo.
                    </p>
                </div>
            }

            <form method="post" class="form-app" id="deleteForm">

                @if (Model.ValorAtual > 0)
                {
                    <div class="field-group">
                        <label class="form-label">Confirma o valor atual da conta poupança para apagar</label>
                        <input type="number" id="valorConfirmacao" class="form-control"
                               placeholder="@Model.ValorAtual.ToString("N2", CultureInfo.InvariantCulture)"
                               step="0.01" />
                        <small class="form-hint">Escreve exatamente <strong>@Model.ValorAtual.ToString("N2") €</strong> para confirmar.</small>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn-app btn-app-danger">Apagar conta poupança</button>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-app btn-app-secondary">Cancelar</a>
                </div>
            </form>
        }

    </div>

</div>

@section Scripts {
    <script>
        const form = document.getElementById('deleteForm');
        const valorEsperado = @Model.ValorAtual.ToString("F2", CultureInfo.InvariantCulture);

        if (form && valorEsperado > 0) {
            form.addEventListener('submit', function (e) {
                const input = document.getElementById('valorConfirmacao');
                const inputVal = parseFloat(input.value.replace(',', '.'));
                if (isNaN(inputVal) || Math.abs(inputVal - valorEsperado) > 0.001) {
                    e.preventDefault();
                    alert('O valor inserido não corresponde ao valor atual da meta. Tenta novamente.');
                    input.focus();
                }
            });
        }
    </script>
}
