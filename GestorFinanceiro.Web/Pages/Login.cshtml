@page
@model GestorFinanceiro.Web.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-layout">
        <aside class="auth-brand" aria-label="Apresentação">
            <div class="auth-brand-inner">
                <a asp-page="/Index" class="auth-brand-logo">
                    <img src="~/imagens/logogf.png" alt="Gestor Financeiro Logo" class="logo-navbar" />
                    <span>Gestor Financeiro</span>
                </a>
                <h1 class="auth-brand-title">Controla as tuas finanças de forma simples</h1>
                <p class="auth-brand-text">
                    Organiza receitas e despesas por sessões, acompanha o saldo global e visualiza
                    a evolução do teu dinheiro num painel claro e intuitivo.
                </p>
                <ul class="auth-brand-features">
                    <li>Dashboard com visão geral</li>
                    <li>Sessões financeiras flexíveis</li>
                    <li>Transferências entre contas</li>
                </ul>
            </div>
        </aside>

        <div class="auth-panel">
            <div class="auth-card">
                <div class="auth-card-header">
                    <h2 class="auth-card-title">Bem-vindo de volta</h2>
                    <p class="auth-card-subtitle">Inicia sessão na tua conta</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.MensagemErro))
                {
                    <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
                }

                @if (!string.IsNullOrEmpty(Model.MensagemSucesso))
                {
                    <div class="alert alert-app alert-app-success">@Model.MensagemSucesso</div>
                }

                <form method="post" class="form-app auth-form">
                    <div class="field-group">
                        <label asp-for="LoginInput" class="form-label">Username ou email</label>
                        <input asp-for="LoginInput" class="form-control" placeholder="Introduz o teu username ou email" autocomplete="username" />
                    </div>

                    <div class="field-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Introduz a tua password" autocomplete="current-password" />
                    </div>

                    <button type="submit" class="btn-app btn-app-primary auth-btn-submit">Entrar</button>
                </form>

                <p class="auth-footer">
                    Ainda não tens conta?
                    <a asp-page="/Register" class="auth-link">Criar conta gratuitamente</a>
                </p>
            </div>
        </div>
    </div>
</div>
