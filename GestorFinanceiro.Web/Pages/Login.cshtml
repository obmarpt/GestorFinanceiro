@page
@model GestorFinanceiro.Web.Pages.LoginModel

@{
    ViewData["Title"] = "Login";
}
<style>
    body {
        background-color: #f5f5f5;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">

            <div class="card shadow">
                <div class="card-body">

                    <h3 class="text-center mb-4">Login</h3>

                    <form method="post">
                        <div class="form-group mb-3">
                            <label>Email</label>
                            <input type="email" class="form-control" placeholder="Introduza o email" />
                        </div>

                        <div class="form-group mb-3">
                            <label>Password</label>
                            <input type="password" class="form-control" placeholder="Introduza a password" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Entrar
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/Register">Criar conta</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>