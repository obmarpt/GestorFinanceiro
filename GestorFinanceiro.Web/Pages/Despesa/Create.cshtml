@page "{sessaoId:int}"
@model GestorFinanceiro.Web.Pages.Despesa.CreateModel

@{
    ViewData["Title"] = "Nova Despesa";
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <h2>Nova Despesa</h2>
    </div>

    <div class="sessions-card form-card">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
        }

        <form method="post" class="form-app">

            <div class="field-group">
                <label asp-for="Descricao" class="form-label">Descrição</label>
                <input asp-for="Descricao" class="form-control" placeholder="Ex: Supermercado" />
                <span asp-validation-for="Descricao" class="text-danger validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="Valor" class="form-label">Valor (€)</label>
                <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Valor" class="text-danger validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="Data" class="form-label">Data</label>
                <input asp-for="Data" class="form-control" type="date" />
                <span asp-validation-for="Data" class="text-danger validation-message"></span>
            </div>

            <div class="field-group">
                <label asp-for="CategoriaId" class="form-label">Categoria (opcional)</label>
                <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-control">
                    <option value="">— Sem categoria —</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger validation-message"></span>
                <a asp-page="/Categoria/Index" class="back-link" style="display:inline-block;margin-top:0.4rem">Gerir categorias</a>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-app btn-app-success">Criar despesa</button>
                <a asp-page="Index" asp-route-sessaoId="@Model.SessaoId" class="btn-app btn-app-secondary">Cancelar</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
