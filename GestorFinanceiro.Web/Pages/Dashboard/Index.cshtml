@page "/Dashboard/Index"
@model GestorFinanceiro.Web.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container dashboard-layout">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Bem-vindo, @Model.Username</h1>
            <p class="subtitle">Painel financeiro</p>
        </div>
        <div class="dashboard-header-actions">
            <a asp-page="/SessaoFinanceira/Create" class="btn-app btn-app-success">➕ Nova Sessão</a>
            <a asp-page="/Meta/Create" class="btn-app btn-app-primary">🎯 Nova Conta Poupança</a>
            <a asp-page="/Dashboard/Reset" class="btn-app btn-app-danger">🗑️ Resetar</a>
            @if (Model.ResumoPorSessao.Count >= 2)
            {
                <a asp-page="/Transferencia/Transferir" class="btn-app btn-app-primary">⇄ Transferir</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }

    @* KPI *@
    <section class="section-block section-block--kpi">
        <h2 class="section-title">Visão geral</h2>
        <div class="summary-cards summary-cards--kpi">
            <div class="kpi-card kpi-card--sessions">
                <div class="kpi-card-header"><span class="kpi-label">Sessões</span><span class="kpi-icon" aria-hidden="true">📊</span></div>
                <div class="kpi-value">@Model.TotalSessoes</div>
            </div>
            <div class="kpi-card kpi-card--receitas">
                <div class="kpi-card-header"><span class="kpi-label">Receitas</span><span class="kpi-icon" aria-hidden="true">↑</span></div>
                <div class="kpi-value">@Model.TotalReceitas.ToString("N2")<span class="kpi-currency">€</span></div>
            </div>
            <div class="kpi-card kpi-card--despesas">
                <div class="kpi-card-header"><span class="kpi-label">Despesas</span><span class="kpi-icon" aria-hidden="true">↓</span></div>
                <div class="kpi-value">@Model.TotalDespesas.ToString("N2")<span class="kpi-currency">€</span></div>
            </div>
            <div class="kpi-card kpi-card--saldo @(Model.Saldo >= 0 ? "kpi-card--saldo-pos" : "kpi-card--saldo-neg")">
                <div class="kpi-card-header"><span class="kpi-label">Saldo</span><span class="kpi-icon" aria-hidden="true">€</span></div>
                <div class="kpi-value">@Model.Saldo.ToString("N2")<span class="kpi-currency">€</span></div>
            </div>
        </div>
    </section>

    @* SALDO HERO *@
    @if (Model.ResumoPorSessao.Any() && string.IsNullOrEmpty(Model.MensagemErro))
    {
        <section class="section-block section-block--saldo">
            <div class="saldo-hero @(Model.Saldo >= 0 ? "saldo-hero--positivo" : "saldo-hero--negativo")">
                <span class="saldo-hero-label">Saldo global disponível</span>
                <div class="saldo-hero-valor">@Model.Saldo.ToString("N2")<span class="saldo-hero-moeda">€</span></div>
                <p class="saldo-hero-hint">@(Model.Saldo >= 0 ? "Tens saldo positivo nas tuas sessões." : "As despesas superam as receitas.")</p>
                @if (Model.ResumoPorSessao.Count >= 2)
                {
                    <div class="saldo-hero-acoes">
                        <a asp-page="/Transferencia/Transferir"
                           asp-route-origemId="@Model.SessaoComMaiorSaldo?.SessaoId"
                           asp-route-valor="@Model.SessaoComMaiorSaldo?.Saldo"
                           class="btn-app btn-app-primary saldo-hero-btn">Transferir</a>
                    </div>
                }
            </div>
        </section>
    }

    @* GRÁFICO *@
    @if (Model.ResumoPorSessao.Any())
    {
        <section class="section-block section-block--chart">
            <div class="chart-box">
                <div class="chart-box-heading">
                    <h2 class="chart-title">Receitas vs Despesas</h2>
                    <p class="chart-box-subtitle">Comparativo por sessão ou totais agregados</p>
                </div>
                @if (Model.TemDadosGraficos)
                {
                    <div class="chart-box-inner">
                        <div class="chart-toolbar">
                            <div class="chart-control">
                                <label for="chartSessaoSelect" class="chart-control-label">Sessão</label>
                                <select id="chartSessaoSelect" class="form-control chart-select">
                                    <option value="todas">Todas</option>
                                    @foreach (var r in Model.ResumoPorSessao)
                                    {
                                        <option value="@r.SessaoId">@r.Nome</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="chart-box-body"><canvas id="chartReceitasDespesas"></canvas></div>
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state--compact"><p>Sem movimentos financeiros para mostrar no gráfico.</p></div>
                }
            </div>
        </section>
    }

    @* SESSOES *@
    <section class="section-block section-block--sessions">
        <div class="sessions-header">
            <h2 class="section-title mb-0">As minhas sessões</h2>
            @if (Model.ResumoPorSessao.Any())
            {
                <a asp-page="/SessaoFinanceira/Index" class="btn-app btn-app-sm btn-app-outline">Ver todas</a>
            }
        </div>
        @if (!Model.ResumoPorSessao.Any() && string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="empty-state">
                <p>Sem sessões criadas. Começa por criar a tua primeira sessão financeira.</p>
                <a asp-page="/SessaoFinanceira/Create" class="btn-app btn-app-success">Criar sessão</a>
            </div>
        }
        else if (Model.ResumoPorSessao.Any())
        {
            <div class="sessoes-grid sessoes-grid--dashboard">
                @foreach (var r in Model.ResumoPorSessao)
                {
                    var saldoClass = r.Saldo > 0 ? "sessao-card--positivo" : r.Saldo < 0 ? "sessao-card--negativo" : "sessao-card--zero";
                    var valorClass = r.Saldo > 0 ? "sessao-card-valor--positivo" : r.Saldo < 0 ? "sessao-card-valor--negativo" : "sessao-card-valor--zero";
                    <article class="sessao-card sessao-card--dashboard @saldoClass">
                        <div class="sessao-card-header">
                            <h3 class="sessao-card-nome">@r.Nome</h3>
                            <time class="sessao-card-data" datetime="@r.DataCriacao.ToString("yyyy-MM-dd")">@r.DataCriacao.ToString("dd MMM yyyy")</time>
                        </div>
                        <div class="sessao-card-valor @valorClass">@r.Saldo.ToString("N2") €</div>
                        <div class="sessao-card-actions">
                            <a asp-page="/SessaoFinanceira/Detalhe" asp-route-id="@r.SessaoId" class="btn-app btn-app-primary btn-app-open">Abrir →</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @* BOLSA *@
    @if (Model.Bolsa.TemSaldo)
    {
        <section class="section-block section-block--bolsa">
            <div class="sessions-header">
                <h2 class="section-title mb-0">💼 Bolsa</h2>
            </div>
            <div class="bolsa-card">
                <div class="bolsa-info">
                    <span class="bolsa-label">Saldo disponível na bolsa</span>
                    <span class="bolsa-valor">@Model.Bolsa.Saldo.ToString("N2") €</span>
                    <span class="bolsa-hint">Dinheiro guardado de sessões apagadas. Transfere para uma sessão ou conta poupança.</span>
                </div>
                <div class="bolsa-acoes">
                    <button type="button" class="btn-app btn-app-primary" onclick="toggleMetaForm('bolsa-sessao')">🏦 Para sessão</button>
                    <button type="button" class="btn-app btn-app-success" onclick="toggleMetaForm('bolsa-meta')">🎯 Para conta poupança</button>
                </div>
                <div id="bolsa-sessao" class="meta-form" style="display:none">
                    <form method="post" asp-page-handler="TransferirBolsaSessao" class="meta-form-inner">
                        <select name="SessaoDestinoId" class="form-control">
                            @foreach (var s in Model.ResumoPorSessao)
                            {
                                <option value="@s.SessaoId">@s.Nome (@s.Saldo.ToString("N2") €)</option>
                            }
                        </select>
                        <input type="number" name="Valor" class="form-control" placeholder="Valor (€)" step="0.01" min="0.01"
                               max="@Model.Bolsa.Saldo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                        <div class="meta-form-actions">
                            <button type="submit" class="btn-app btn-app-sm btn-app-primary">Confirmar</button>
                            <button type="button" class="btn-app btn-app-sm btn-app-secondary" onclick="toggleMetaForm('bolsa-sessao')">Cancelar</button>
                        </div>
                    </form>
                </div>
                @if (Model.Metas.Any())
                {
                    <div id="bolsa-meta" class="meta-form" style="display:none">
                        <form method="post" asp-page-handler="TransferirBolsaMeta" class="meta-form-inner">
                            <select name="MetaDestinoId" class="form-control">
                                @foreach (var m in Model.Metas)
                                {
                                    <option value="@m.Id">@m.Nome</option>
                                }
                            </select>
                            <input type="number" name="Valor" class="form-control" placeholder="Valor (€)" step="0.01" min="0.01"
                                   max="@Model.Bolsa.Saldo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                            <div class="meta-form-actions">
                                <button type="submit" class="btn-app btn-app-sm btn-app-success">Confirmar</button>
                                <button type="button" class="btn-app btn-app-sm btn-app-secondary" onclick="toggleMetaForm('bolsa-meta')">Cancelar</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    @* METAS *@
    <section class="section-block section-block--metas">
        <div class="sessions-header">
            <h2 class="section-title mb-0">As minhas contas poupanças</h2>
            <a asp-page="/Meta/Create" class="btn-app btn-app-sm btn-app-outline">+ Nova conta poupança</a>
        </div>
        @if (!Model.Metas.Any())
        {
            <div class="empty-state">
                <p>Ainda não tens metas definidas. Cria a tua primeira conta poupança.</p>
                <a asp-page="/Meta/Create" class="btn-app btn-app-success">Criar conta poupança</a>
            </div>
        }
        else
        {
            <div class="sessoes-grid sessoes-grid--dashboard">
                @foreach (var meta in Model.Metas)
                {
                    var cardClass = meta.Concluida ? "sessao-card--positivo" : "";
                    <article class="sessao-card sessao-card--dashboard @cardClass">
                        <div class="sessao-card-header">
                            <h3 class="sessao-card-nome">@if (meta.Concluida){
                                <span>✅ </span>
                            }
                            @meta.Nome</h3>
                            <div class="sessao-card-actions-inline">
                                <a asp-page="/Meta/Edit" asp-route-id="@meta.Id" class="btn-app btn-app-sm btn-app-outline">Editar</a>
                                <a asp-page="/Meta/Delete" asp-route-id="@meta.Id" class="btn-app btn-app-sm btn-app-danger">Apagar</a>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(meta.Descricao))
                        {
                            <p class="sessao-card-descricao">@meta.Descricao</p>
                        }
                        <div class="meta-progress">
                            <div class="meta-progress-bar @(meta.Concluida ? "meta-progress-bar--concluida" : "")"
                                 style="width: @meta.Percentagem.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="meta-valores">
                            <span class="meta-valor-atual">@meta.ValorAtual.ToString("N2") €</span>
                            <span class="meta-percentagem">@meta.Percentagem.ToString("F1")%</span>
                            <span class="meta-valor-alvo">@meta.ValorAlvo.ToString("N2") €</span>
                        </div>
                        <div class="meta-acoes">
                            <button type="button" class="btn-app btn-app-sm btn-app-success" onclick="toggleMetaForm('depositar-@meta.Id')">↑ Depositar</button>
                            <button type="button" class="btn-app btn-app-sm btn-app-danger" onclick="toggleMetaForm('levantar-@meta.Id')">↓ Levantar</button>
                        </div>
                        <div id="depositar-@meta.Id" class="meta-form" style="display:none">
                            <form method="post" asp-page-handler="Depositar" class="meta-form-inner">
                                <input type="hidden" name="MetaId" value="@meta.Id" />
                                <select name="SessaoOrigemId" class="form-control">
                                    @foreach (var s in Model.ResumoPorSessao)
                                    {
                                        <option value="@s.SessaoId">@s.Nome (@s.Saldo.ToString("N2") €)</option>
                                    }
                                </select>
                                <input type="number" name="Valor" class="form-control" placeholder="Valor (€)" step="0.01" min="0.01" />
                                <div class="meta-form-actions">
                                    <button type="submit" class="btn-app btn-app-sm btn-app-success">Confirmar</button>
                                    <button type="button" class="btn-app btn-app-sm btn-app-secondary" onclick="toggleMetaForm('depositar-@meta.Id')">Cancelar</button>
                                </div>
                            </form>
                        </div>
                        <div id="levantar-@meta.Id" class="meta-form" style="display:none">
                            <form method="post" asp-page-handler="Levantar" class="meta-form-inner">
                                <input type="hidden" name="MetaId" value="@meta.Id" />
                                <select name="SessaoDestinoId" class="form-control">
                                    @foreach (var s in Model.ResumoPorSessao)
                                    {
                                        <option value="@s.SessaoId">@s.Nome</option>
                                    }
                                </select>
                                <input type="number" name="Valor" class="form-control" placeholder="Valor (€)" step="0.01" min="0.01"
                                       max="@meta.ValorAtual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                <div class="meta-form-actions">
                                    <button type="submit" class="btn-app btn-app-sm btn-app-primary">Confirmar</button>
                                    <button type="button" class="btn-app btn-app-sm btn-app-secondary" onclick="toggleMetaForm('levantar-@meta.Id')">Cancelar</button>
                                </div>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @* HISTORICO *@
    <section class="section-block section-block--historico">
        <div class="sessions-header">
            <h2 class="section-title mb-0">Histórico recente</h2>
        </div>
        @if (!Model.Historico.Any())
        {
            <div class="empty-state empty-state--compact">
                <p>Ainda não há transferências ou movimentos registados.</p>
            </div>
        }
        else
        {
            <div class="historico-list">
                @foreach (var item in Model.Historico)
                {
                    <div class="historico-item">
                        <span class="historico-icone @(item.Tipo == "Receita" || item.Tipo.Contains("Deposito") ? "historico-icone--entrada" : item.Tipo == "Despesa" || item.Tipo.Contains("Levantamento") ? "historico-icone--saida" : "")">
                            @item.Icone
                        </span>
                        <div class="historico-info">
                            <span class="historico-descricao">@item.Descricao</span>
                            <span class="historico-tipo">@item.Tipo</span>
                        </div>
                        <div class="historico-right">
                            <span class="historico-valor">@item.Valor.ToString("N2") €</span>
                            <span class="historico-data">@item.Data.ToString("dd MMM yyyy HH:mm")</span>
                            <form method="post" asp-page-handler="ApagarHistorico" style="margin-top:0.25rem"
                                  onsubmit="return confirm('Tens a certeza que queres apagar este registo?')">
                                <input type="hidden" name="RegistoId" value="@item.RegistoId" />
                                <input type="hidden" name="TipoRegisto" value="@item.TipoRegisto" />
                                <button type="submit" class="btn-app btn-app-sm btn-app-outline-danger">Apagar</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>

@section Scripts {
    @if (Model.TemDadosGraficos)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>window.dashboardChartData = @Html.Raw(Model.ChartDataJson);</script>
        <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    }

    <script>
        function toggleMetaForm(id) {
            var form = document.getElementById(id);
            if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    </script>
}

