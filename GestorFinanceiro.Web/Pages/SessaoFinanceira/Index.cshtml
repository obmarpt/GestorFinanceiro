@page
@model GestorFinanceiro.Web.Pages.SessaoFinanceira.IndexModel

@{
    ViewData["Title"] = "Sessões Financeiras";
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Sessões</h1>
            <p class="subtitle">Gerir as tuas sessões financeiras</p>
        </div>
        <a asp-page="Create" class="btn-app btn-app-success">➕ Nova Sessão</a>
    </div>
    <div class="mt-3">
        <a asp-page="/Dashboard/Index" class="back-link">← Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }

    @if (!Model.ResumoPorSessao.Any() && string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="sessions-card">
            <div class="empty-state">
                <p>Ainda não tens sessões criadas.</p>
                <a asp-page="Create" class="btn-app btn-app-success">Criar primeira sessão</a>
            </div>
        </div>
    }
    else if (Model.ResumoPorSessao.Any())
    {
        <div class="sessoes-grid">
            @foreach (var r in Model.ResumoPorSessao)
            {
                var saldoClass = r.Saldo > 0 ? "sessao-card--positivo" : r.Saldo < 0 ? "sessao-card--negativo" : "sessao-card--zero";
                var badgeClass = r.Saldo > 0 ? "saldo-badge--positivo" : r.Saldo < 0 ? "saldo-badge--negativo" : "saldo-badge--zero";

                <article class="sessao-card @saldoClass">
                    <div class="sessao-card-header">
                        <h2 class="sessao-card-nome">@r.Nome</h2>
                        <time class="sessao-card-data" datetime="@r.DataCriacao.ToString("yyyy-MM-dd")">
                            @r.DataCriacao.ToString("dd MMM yyyy")
                        </time>
                    </div>

                    <div class="sessao-card-stats">
                        <div class="sessao-stat sessao-stat--receitas">
                            <span class="sessao-stat-label">Receitas</span>
                            <span class="sessao-stat-value">@r.TotalReceitas.ToString("N2") €</span>
                        </div>
                        <div class="sessao-stat sessao-stat--despesas">
                            <span class="sessao-stat-label">Despesas</span>
                            <span class="sessao-stat-value">@r.TotalDespesas.ToString("N2") €</span>
                        </div>
                    </div>

                    <div class="sessao-card-saldo">
                        <span class="sessao-saldo-label">Saldo</span>
                        <span class="saldo-badge @badgeClass">@r.Saldo.ToString("N2") €</span>
                    </div>

                    <div class="sessao-card-actions">
                        <a asp-page="Detalhe" asp-route-id="@r.SessaoId"
                           class="btn-app btn-app-primary btn-app-open">Abrir →</a>
                        <a asp-page="Edit" asp-route-id="@r.SessaoId"
                           class="btn-app btn-app-outline">Editar</a>
                        <a asp-page="Delete" asp-route-id="@r.SessaoId"
                           class="btn-app btn-app-danger">Apagar</a>
                    </div>
                </article>
            }
        </div>
    }

</div>
