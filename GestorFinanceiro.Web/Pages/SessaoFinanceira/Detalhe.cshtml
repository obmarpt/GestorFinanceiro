@page "{id:int}"
@model GestorFinanceiro.Web.Pages.SessaoFinanceira.DetalheModel

@{
    ViewData["Title"] = Model.Nome;
}

<div class="dashboard-container">

    <partial name="_StatusMessages" />

    <div class="dashboard-header">
        <div>
            <h1 class="page-title">@Model.Nome</h1>
            <p class="subtitle">@(Model.Descricao ?? "Detalhe da sessão") · @Model.DataCriacao.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="dashboard-header-actions">
            <a asp-page="/SessaoFinanceira/Edit" asp-route-id="@Model.Id"
               class="btn-app btn-app-outline btn-app-sm">Editar</a>
            <a asp-page="/SessaoFinanceira/Delete" asp-route-id="@Model.Id"
               class="btn-app btn-app-danger btn-app-sm">Apagar</a>
            <a asp-page="/SessaoFinanceira/Index" class="btn-app btn-app-secondary btn-app-sm">← Sessões</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-app alert-app-danger">@Model.MensagemErro</div>
    }
    else
    {
        <div class="summary-cards summary-cards--hero mb-4">
            <div class="summary-card summary-card--receitas">
                <span class="summary-label">Receitas</span>
                <div class="value value--hero">@Model.TotalReceitas.ToString("N2") €</div>
            </div>
            <div class="summary-card summary-card--despesas">
                <span class="summary-label">Despesas</span>
                <div class="value value--hero">@Model.TotalDespesas.ToString("N2") €</div>
            </div>
            <div class="summary-card summary-card--saldo">
                <span class="summary-label">Saldo</span>
                <div class="value value--hero @(Model.Saldo >= 0 ? "positive" : "negative")">
                    @Model.Saldo.ToString("N2") €
                </div>
            </div>
        </div>

        <div class="detail-actions mb-4">
            <a asp-page="/Receita/Index" asp-route-sessaoId="@Model.Id" class="btn-app btn-app-success">Receitas</a>
            <a asp-page="/Despesa/Index" asp-route-sessaoId="@Model.Id" class="btn-app btn-app-danger">Despesas</a>
            @if (Model.Saldo > 0)
            {
                <a asp-page="/Transferencia/Transferir" asp-route-origemId="@Model.Id" asp-route-valor="@Model.Saldo"
                   class="btn-app btn-app-primary">Transferir saldo</a>
            }
        </div>

        <div class="detail-grid">
            <div class="sessions-card">
                <div class="sessions-header" style="margin-bottom:1rem">
                    <h2 class="section-title section-title--sm mb-0">Últimas receitas</h2>
                    <a asp-page="/Receita/Index" asp-route-sessaoId="@Model.Id"
                       class="btn-app btn-app-sm btn-app-outline">Ver todas</a>
                </div>
                @if (Model.Receitas.Any())
                {
                    <div class="historico-list">
                        @foreach (var r in Model.Receitas)
                        {
                            <div class="historico-item">
                                <span class="historico-icone historico-icone--entrada">↑</span>
                                <div class="historico-info">
                                    <span class="historico-descricao">@r.Descricao</span>
                                    <span class="historico-tipo">Receita</span>
                                </div>
                                <div class="historico-right">
                                    <span class="historico-valor" style="color:var(--success)">@r.Valor.ToString("N2") €</span>
                                    <span class="historico-data">@r.Data.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state--compact">
                        <p>Sem receitas registadas.</p>
                    </div>
                }
            </div>

            <div class="sessions-card">
                <div class="sessions-header" style="margin-bottom:1rem">
                    <h2 class="section-title section-title--sm mb-0">Últimas despesas</h2>
                    <a asp-page="/Despesa/Index" asp-route-sessaoId="@Model.Id"
                       class="btn-app btn-app-sm btn-app-outline">Ver todas</a>
                </div>
                @if (Model.Despesas.Any())
                {
                    <div class="historico-list">
                        @foreach (var d in Model.Despesas)
                        {
                            <div class="historico-item">
                                <span class="historico-icone historico-icone--saida">↓</span>
                                <div class="historico-info">
                                    <span class="historico-descricao">@d.Descricao</span>
                                    <span class="historico-tipo">Despesa</span>
                                </div>
                                <div class="historico-right">
                                    <span class="historico-valor" style="color:var(--danger)">@d.Valor.ToString("N2") €</span>
                                    <span class="historico-data">@d.Data.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state--compact">
                        <p>Sem despesas registadas.</p>
                    </div>
                }
            </div>
        </div>
    }

</div>
