@page
@model GestorFinanceiro.Web.Pages.SessaoFinanceira.CreateModel

@{
    ViewData["Title"] = "Nova Sessão";
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <h2>Nova Sessão Financeira</h2>
    </div>

    <div class="sessions-card col-md-8 mx-auto">

        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-danger">@Model.MensagemErro</div>
        }

        <form method="post">

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Finanças pessoais 2026" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Descricao" class="form-label">Descrição (opcional)</label>
                <textarea asp-for="Descricao" class="form-control" rows="3"
                          placeholder="Breve descrição da sessão"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Criar sessão</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
