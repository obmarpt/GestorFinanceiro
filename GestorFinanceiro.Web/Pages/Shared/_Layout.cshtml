<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestorFinanceiro</title>

    <!-- ✅ Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ✅ CSS global -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ✅ NOVO CSS personalizado -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/GestorFinanceiro.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ✅ NAVBAR MODERNA -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-page="/Index">
                    💰 GestorFinanceiro
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">

                    <!-- ✅ Left Menu -->
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Dashboard</a>
                        </li>

                    </ul>

                    <!-- ✅ Right Side (LOGIN STATE) -->
                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3 text-white d-flex align-items-center">
                                👤 @User.Identity.Name
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-sm btn-danger" asp-page="/Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Register">Registo</a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ MAIN CONTENT -->
    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ FOOTER MELHORADO -->
    <footer class="text-center mt-5 mb-3 text-muted">
        <small>&copy; 2026 - GestorFinanceiro</small>
    </footer>

    <!-- ✅ Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
